# docker compose watch demo. `just` lists recipes.

compose := "docker compose"
port := env("GATEWAY_PORT", "8090")

# List recipes
default:
    @just --list --unsorted

# Build, start and watch in the foreground (Ctrl-C stops watching AND the containers)
up:
    {{compose}} up --build --watch

# Build and start detached, no watching
start:
    {{compose}} up -d --build --wait

# Watch an already running stack (Ctrl-C leaves containers running)
watch:
    {{compose}} watch --no-up

# Hands-free tour: edits every watched file, verifies the effect, restores
demo:
    ./scripts/demo.sh

# Containers and a quick check of each endpoint
status:
    @{{compose}} ps -a
    @echo; curl -fsS http://localhost:{{port}}/ | grep -o '<p id="message">.*</p>' || true
    @curl -fsSI http://localhost:{{port}}/ | grep -i x-demo-banner || true
    @curl -fsS http://localhost:{{port}}/api/ | grep -E '"greeting"|"started"' || true
    @curl -fsS http://localhost:{{port}}/notes/ | grep -o 'build #[0-9]*' || true

# Follow all logs
logs:
    {{compose}} logs -f

# Stop and remove containers (keeps volume and images)
down:
    {{compose}} down --remove-orphans

# Remove containers, the project's images and named volumes
clean:
    {{compose}} down --volumes --rmi local --remove-orphans
