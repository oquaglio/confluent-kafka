# Flink SQL dedup PoC. `just` lists recipes.

compose := "docker compose"
psql := "docker exec postgres psql -U flink_user -d flink_demo"
flink := "docker exec flink-jobmanager /opt/flink/bin/flink"

# List recipes
default:
    @just --list --unsorted

# Build images, start the stack and wait for the Flink job to be RUNNING (then `just produce`)
up:
    {{compose}} up -d --build
    @echo "Waiting for flink-job-submit (Flink + Postgres healthy, then submit)..."
    @code=$(docker wait flink-job-submit); \
      docker logs flink-job-submit 2>&1 | grep -E "^(Job|Submitting|Can't)" || true; \
      test "$code" = 0

# Build all images, including the producer (downloads the connector jars on first build)
build:
    {{compose}} --profile producer build

# Containers, Flink jobs and the Postgres table
status:
    @{{compose}} ps -a
    @echo; {{flink}} list -m localhost:9081 2>/dev/null | grep -v '^Waiting' || true
    @echo; {{psql}} -c '\d sensor_readings'

# Submit the dedup job again if it isn't running (e.g. after `just cancel`)
submit:
    {{compose}} run --rm flink-job-submit

# Interactive Flink SQL client with sensor_source/sensor_sink already defined
sql:
    docker exec -it flink-sql-client /opt/flink/bin/sql-client.sh -i /opt/flink-sql/flink_sql_source_sink.sql

# Run the producer container for N seconds (0 = until Ctrl+C) at R msgs/s (0 = as fast as possible)
produce secs="5" rate="0":
    {{compose}} run --rm -e DURATION={{secs}} -e RATE={{rate}} producer

# Run the producer on the host with uv instead (needs uv, talks to localhost:9092)
produce-local secs="5" rate="0":
    DURATION={{secs}} RATE={{rate}} uv run --with-requirements data-generator/requirements.txt data-generator/data_generator.py

# Row count in Postgres sensor_readings
count:
    {{psql}} -c 'SELECT count(*) FROM sensor_readings'

# Latest N rows in Postgres sensor_readings
rows n="10":
    {{psql}} -c 'SELECT * FROM sensor_readings ORDER BY "timestamp" DESC LIMIT {{n}}'

# First N raw messages on the sensor-data topic
consume n="10":
    docker exec broker kafka-console-consumer --bootstrap-server broker:29092 \
      --topic sensor-data --from-beginning --max-messages {{n}}

# List running Flink jobs
jobs:
    {{flink}} list -m localhost:9081

# Cancel a Flink job by id (see `just jobs`)
cancel id:
    {{flink}} cancel -m localhost:9081 {{id}}

# Follow logs (all services, or one: `just logs flink-jobmanager`)
logs *svc:
    {{compose}} logs -f {{svc}}

# Stop and remove containers (keeps the Postgres volume)
down:
    {{compose}} --profile producer down --remove-orphans

# Stop and remove containers and volumes (Postgres data is lost; init.sql runs again next `up`)
clean:
    {{compose}} --profile producer down -v --remove-orphans
